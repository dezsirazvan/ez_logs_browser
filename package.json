{
  "name": "@ezlogs/browser",
  "version": "0.4.1",
  "description": "Tells EZLogs when your app's Supabase calls fail. Sends no login, no password, no data (a failed sign-in names the email typed). Never breaks your app.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "keywords": [
    "ezlogs",
    "supabase",
    "lovable",
    "activity-log",
    "audit-log"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dezsirazvan/ez_logs_browser.git"
  },
  "homepage": "https://ezlogs.io",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
